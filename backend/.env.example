# Database — Neon pooled connection (runtime)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# Database — Neon direct connection (migrations + integration tests)
DATABASE_URL_DIRECT=postgresql://user:password@ep-xxx-direct.neon.tech/neondb?sslmode=require

# JWT
JWT_ACCESS_SECRET=replace-with-random-64-char-hex
JWT_REFRESH_SECRET=replace-with-different-random-64-char-hex

# Cloudflare R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-api-token-key-id
R2_SECRET_ACCESS_KEY=your-r2-api-token-secret
S3_BUCKET_NAME=your-bucket-name

# Resend (email)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Internal cron secret (shared between GHA workflow and this server); generate with: openssl rand -hex 32
INTERNAL_CRON_SECRET=replace-with-random-64-char-hex

# Frontend origin (used for CORS allowlist and invite links)
FRONTEND_URL=http://localhost:3000

# Node environment
NODE_ENV=development
